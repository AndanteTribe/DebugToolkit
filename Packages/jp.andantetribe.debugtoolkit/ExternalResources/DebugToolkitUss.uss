/*  DebugToolkit のスタイル一式。
    ランタイムパネルに割り当てるのは DefaultRuntimeTheme.tss の方。

    import の順序には意味がある:
      Variables を最初に（他が参照するトークン）、Base を次に（土台）、
      コントロール類、最後に Window（DebugToolkit 固有の上書き）。
    同じ詳細度のルールは後勝ちなので、順序を入れ替えると見た目が変わる。 */
@import url("Parts/Variables.uss");
@import url("Parts/Base.uss");
@import url("Parts/Buttons.uss");
@import url("Parts/Fields.uss");
@import url("Parts/Sliders.uss");
@import url("Parts/Containers.uss");
@import url("Parts/Collections.uss");
@import url("Parts/Window.uss");
